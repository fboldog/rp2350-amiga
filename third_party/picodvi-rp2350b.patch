diff --git a/software/libdvi/dvi_serialiser.c b/software/libdvi/dvi_serialiser.c
--- a/software/libdvi/dvi_serialiser.c
+++ b/software/libdvi/dvi_serialiser.c
@@ -44,10 +44,23 @@
-	// Use a PWM slice to drive the pixel clock. Both GPIOs must be on the same
-	// slice (lower-numbered GPIO must be even).
-	assert(cfg->pins_clk % 2 == 0);
-	uint slice = pwm_gpio_to_slice_num(cfg->pins_clk);
-	// 5 cycles high, 5 low. Invert one channel so that we get complementary outputs.
-	pwm_config pwm_cfg = pwm_get_default_config();
-	pwm_config_set_output_polarity(&pwm_cfg, true, false);
-	pwm_config_set_wrap(&pwm_cfg, 9);
-	pwm_init(slice, &pwm_cfg, false);
-	pwm_set_both_levels(slice, 5, 5);
+	// Use PWM to drive the pixel clock. An even-start pair shares one slice;
+	// an odd-start pair spans two slices, which must be configured separately.
+	uint slice_pos = pwm_gpio_to_slice_num(cfg->pins_clk);
+	uint slice_neg = pwm_gpio_to_slice_num(cfg->pins_clk + 1);
+	pwm_config pwm_cfg = pwm_get_default_config();
+	pwm_config_set_wrap(&pwm_cfg, 9);
+	if (slice_pos == slice_neg) {
+		// Even GPIO is channel A (+), odd GPIO is channel B (-).
+		pwm_config_set_output_polarity(&pwm_cfg, true, false);
+		pwm_init(slice_pos, &pwm_cfg, false);
+		pwm_set_both_levels(slice_pos, 5, 5);
+	}
+	else {
+		// Odd GPIO is channel B (+); the following even GPIO is channel A (-).
+		pwm_config_set_output_polarity(&pwm_cfg, false, true);
+		pwm_init(slice_pos, &pwm_cfg, false);
+		pwm_set_both_levels(slice_pos, 5, 5);
+		pwm_cfg = pwm_get_default_config();
+		pwm_config_set_wrap(&pwm_cfg, 9);
+		pwm_config_set_output_polarity(&pwm_cfg, false, false);
+		pwm_init(slice_neg, &pwm_cfg, false);
+		pwm_set_both_levels(slice_neg, 5, 5);
+	}
@@ -69 +82,3 @@
-		pwm_set_enabled(pwm_gpio_to_slice_num(cfg->pins_clk), true);
+		uint32_t pwm_mask = 1u << pwm_gpio_to_slice_num(cfg->pins_clk) |
+			1u << pwm_gpio_to_slice_num(cfg->pins_clk + 1);
+		pwm_set_mask_enabled(pwm_mask);
@@ -73 +88,2 @@
-		pwm_set_enabled(pwm_gpio_to_slice_num(cfg->pins_clk), false);
+		pwm_set_enabled(pwm_gpio_to_slice_num(cfg->pins_clk), false);
+		pwm_set_enabled(pwm_gpio_to_slice_num(cfg->pins_clk + 1), false);
